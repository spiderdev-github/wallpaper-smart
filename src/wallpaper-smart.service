# wallpaper-smart.service
[Unit]
Description=Smart wallpaper updater (time + weather)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# WALLDIR sera fourni par un override ou par l'environnement utilisateur
ExecStart=%h/.local/bin/wallpaper-smart.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
