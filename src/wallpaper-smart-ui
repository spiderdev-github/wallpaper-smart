def migrate_enabled_images(cfg: dict) -> None:
    enabled = cfg.get("enabled_images")
    if not isinstance(enabled, dict) or not enabled:
        return

    theme = (cfg.get("wallpaper_theme") or "default").strip() or "default"
    out = {}
    changed = False

    for k, v in enabled.items():
        if isinstance(k, str) and k.startswith("templates/"):
            out[k] = v
            continue

        if isinstance(k, str) and (k.startswith("base/") or k.startswith("meteo/")):
            kind, rest = k.split("/", 1)
            nk = f"templates/{theme}/{kind}/{rest}"
            out[nk] = v
            changed = True
            continue

        out[k] = v

    if changed:
        cfg["enabled_images"] = out
        
