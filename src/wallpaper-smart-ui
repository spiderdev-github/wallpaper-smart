            except Exception:
                self.message("Erreur", "Latitude/Longitude invalides")
                sw.set_active(False)
                try:
                    self.entry_aube_time.set_sensitive(True)
                    self.entry_coucher_time.set_sensitive(True)
                except Exception:
                    pass
                return None

            # Run network call in background thread (do not block GTK main loop)
            t = threading.Thread(target=self._fetch_and_apply_sun_times, args=(lat, lon, sw), daemon=True)
            t.start()
            return None
        except Exception as e:
            self.message("Erreur", str(e))
            return None


    def _fetch_and_apply_sun_times(self, lat: float, lon: float, sw):
        # Background thread: fetch sunrise/sunset then update UI via GLib.idle_add
        try:
            from gi.repository import GLib

            # Open-Meteo: need 2 days to compute "nuit" midpoint using tomorrow sunrise
            url = (
                "https://api.open-meteo.com/v1/forecast"
                f"?latitude={lat}"
                f"&longitude={lon}"
                "&daily=sunrise,sunset"
                "&forecast_days=2"
                "&timezone=Europe%2FParis"
            )

            req = urllib.request.Request(url, headers={"User-Agent": "wallpaper-smart-ui"})
            with urllib.request.urlopen(req, timeout=10) as r:
                raw = r.read().decode("utf-8", errors="replace")

            data = json.loads(raw)

            daily = data.get("daily", {}) or {}
            sunrise_list = daily.get("sunrise", []) or []
            sunset_list = daily.get("sunset", []) or []

            if len(sunrise_list) < 2 or len(sunset_list) < 1:
                raise Exception("Aucune donnee sunrise/sunset suffisante retournee par l API")

            sunrise_today_iso = str(sunrise_list[0])
            sunset_today_iso = str(sunset_list[0])
            sunrise_tomorrow_iso = str(sunrise_list[1])

            def _hhmm_from_iso(iso_str: str) -> str:
                if "T" in iso_str:
                    t = iso_str.split("T", 1)[1]
                else:
                    t = iso_str
                parts = t.split(":")
                if len(parts) >= 2:
                    hh = parts[0].zfill(2)
                    mm = parts[1].zfill(2)
                    return f"{hh}:{mm}"
                return ""

            def _minutes_from_hhmm(hhmm: str) -> int:
                parts = (hhmm or "").split(":")
                if len(parts) != 2:
                    return 0
                h = int(parts[0])
                m = int(parts[1])
                if h < 0:
                    h = 0
                if h > 23:
                    h = 23
                if m < 0:
                    m = 0
                if m > 59:
                    m = 59
                return h * 60 + m

            def _hhmm_from_minutes(mins: int) -> str:
                mins = int(mins) % (24 * 60)
                h = mins // 60
                m = mins % 60
                return f"{h:02d}:{m:02d}"

            # Base times
            aube_hhmm = _hhmm_from_iso(sunrise_today_iso)
            coucher_hhmm = _hhmm_from_iso(sunset_today_iso)
            sunrise_tomorrow_hhmm = _hhmm_from_iso(sunrise_tomorrow_iso)

            if not aube_hhmm or not coucher_hhmm or not sunrise_tomorrow_hhmm:
                raise Exception("Format sunrise/sunset invalide")

            aube_min = _minutes_from_hhmm(aube_hhmm)
            coucher_min = _minutes_from_hhmm(coucher_hhmm)
            sunrise_tomorrow_min = _minutes_from_hhmm(sunrise_tomorrow_hhmm)

            # Option A:
            # midi = midpoint between sunrise and sunset (today)
            # nuit = midpoint between sunset (today) and sunrise (tomorrow) across midnight
            day_len = coucher_min - aube_min
            if day_len <= 0:
                raise Exception("Horaires incoherents (sunset <= sunrise)")

            midi_min = aube_min + (day_len // 2)

            night_len = (24 * 60 - coucher_min) + sunrise_tomorrow_min
            if night_len <= 0:
                raise Exception("Horaires incoherents (night length)")

            nuit_min = (coucher_min + (night_len // 2)) % (24 * 60)

            midi_hhmm = _hhmm_from_minutes(midi_min)
            nuit_hhmm = _hhmm_from_minutes(nuit_min)

            def _apply():
                try:
                    # Fill entries
                    self.entry_aube_time.set_text(aube_hhmm)
                    self.entry_midi_time.set_text(midi_hhmm)
                    self.entry_coucher_time.set_text(coucher_hhmm)
                    self.entry_nuit_time.set_text(nuit_hhmm)

                    sw.set_active(True)

                    # Optional feedback
                    self.message(
                        "OK",
                        f"Aube: {aube_hhmm}  Midi: {midi_hhmm}  Coucher: {coucher_hhmm}  Nuit: {nuit_hhmm}",
                    )
                except Exception as e:
                    self.message("Erreur", str(e))
                return False

            GLib.idle_add(_apply)
        except Exception as e:
            try:
                from gi.repository import GLib

                def _fail():
                    self.message("Erreur", f"Impossible de recuperer horaires auto: {e}")
                    try:
                        sw.set_active(False)
                        self.entry_aube_time.set_sensitive(True)
                        self.entry_coucher_time.set_sensitive(True)
                        self.entry_midi_time.set_sensitive(True)
                        self.entry_nuit_time.set_sensitive(True)
                    except Exception:
                        pass
                    return False

                GLib.idle_add(_fail)
            except Exception:
                try:
                    self.message("Erreur", str(e))
                except Exception:
                    pass



