    def on_test(self, _btn):
        try:
            # 1) Construire une config temporaire depuis l'UI (sans sauvegarder la vraie)
            cfg = json.loads(json.dumps(self.cfg))  # copie safe

            # Wallpaper dir
            if hasattr(self, "folder_entry"):
                cfg["wallpaper_dir"] = self.folder_entry.get_text().strip()

            # Timer
            if hasattr(self, "spin_minutes"):
                cfg["timer_minutes"] = int(self.spin_minutes.get_value())

            # Schedule
            if hasattr(self, "spin_nuit"):
                cfg["schedule"] = {
                    "nuit_start": int(self.spin_nuit.get_value()),
                    "aube_start": int(self.spin_aube.get_value()),
                    "midi_start": int(self.spin_midi.get_value()),
                    "coucher_start": int(self.spin_coucher.get_value()),
                }

            # Geoloc (mode + lat/lon + city + preset)
            cfg.setdefault("geolocation", {})
            if hasattr(self, "geo_combo"):
                cfg["geolocation"]["mode"] = self.geo_combo.get_active_id()

            if hasattr(self, "lat_entry") and hasattr(self, "lon_entry"):
                try:
                    cfg["geolocation"].setdefault("fixed", {})
                    cfg["geolocation"]["fixed"]["lat"] = float(self.lat_entry.get_text().strip())
                    cfg["geolocation"]["fixed"]["lon"] = float(self.lon_entry.get_text().strip())
                except Exception:
                    pass

            if hasattr(self, "city_entry"):
                cfg["geolocation"]["city_name"] = self.city_entry.get_text().strip()

            if hasattr(self, "preset_combo"):
                # value stored in combo id
                preset_id = self.preset_combo.get_active_id() or "none"
                cfg["geolocation"]["preset"] = preset_id

            # Mapping
            if hasattr(self, "map_entries"):
                cfg.setdefault("weather_mapping", {})
                for k, e in self.map_entries.items():
                    cfg["weather_mapping"][k] = e.get_text().strip()

            # enabled_images
            cfg.setdefault("enabled_images", self.cfg.get("enabled_images", {}))

            # 2) Ecrire config temporaire
            tmp = APP_DIR / "config.test.json"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2, ensure_ascii=False)

            # 3) Lancer wallpaper-smart.sh avec la config temporaire
            script = Path.home() / ".local/bin/wallpaper-smart.sh"
            p = subprocess.run(
                [str(script)],
                text=True,
                capture_output=True,
                env={**os.environ, "CONFIG_FILE": str(tmp)},
            )

            out = (p.stdout + "\n" + p.stderr).strip()
            self.message(_("Résultat test"), out or _("(aucune sortie)"))
        except Exception as e:
            self.message(_("Erreur test"), str(e))


