    def build_tab_time(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            grid = Gtk.Grid(column_spacing=10, row_spacing=8)

            def parse_time_text(txt: str):
                txt = (txt or "").strip()
                if not txt:
                    return None, None

                # Accept "H", "HH", "H:MM", "HH:MM"
                if ":" in txt:
                    parts = txt.split(":")
                    if len(parts) != 2:
                        return None, None
                    try:
                        h = int(parts[0].strip() or "0")
                        m = int(parts[1].strip() or "0")
                    except Exception:
                        return None, None
                else:
                    try:
                        h = int(txt)
                    except Exception:
                        return None, None
                    m = 0

                if h < 0:
                    h = 0
                if h > 23:
                    h = 23
                if m < 0:
                    m = 0
                if m > 59:
                    m = 59
                return h, m

            def format_time(h, m) -> str:
                if h is None or m is None:
                    return ""
                return f"{int(h):02d}:{int(m):02d}"

            def get_hm(sch: dict, key: str):
                v = sch.get(key, None)

                if isinstance(v, int):
                    return v, 0

                if isinstance(v, str):
                    h, m = parse_time_text(v)
                    if h is None or m is None:
                        return 0, 0
                    return h, m

                if isinstance(v, dict):
                    h = v.get("h", v.get("hour", 0))
                    m = v.get("m", v.get("minute", 0))
                    try:
                        return int(h), int(m)
                    except Exception:
                        return 0, 0

                return 0, 0

            def time_field(initial_h: int, initial_m: int):
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)

                e = Gtk.Entry()
                e.set_width_chars(5)
                e.set_max_width_chars(5)
                e.set_placeholder_text("HH:MM")
                e.set_alignment(0.5)
                e.set_text(format_time(initial_h, initial_m))
                set_hand_cursor_on_hover(e)

                btn = Gtk.Button()
                btn.set_relief(Gtk.ReliefStyle.NONE)
                btn.set_focus_on_click(False)
                btn.set_tooltip_text("Vider")
                btn.get_style_context().add_class("time-clear-btn")

                img = Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON)
                btn.set_image(img)
                set_hand_cursor_on_hover(btn)

                def on_clear(_b):
                    e.set_text("")

                btn.connect("clicked", on_clear)

                def on_focus_out(_w, _ev):
                    txt = (e.get_text() or "").strip()
                    if not txt:
                        return False
                    h, m = parse_time_text(txt)
                    if h is None or m is None:
                        e.set_text("")
                        return False
                    e.set_text(format_time(h, m))
                    return False

                e.connect("focus-out-event", on_focus_out)

                row.pack_start(e, False, False, 0)
                row.pack_start(btn, False, False, 0)

                return row, e

            sch = self.cfg.get("schedule", {})

            h_aube, m_aube = get_hm(sch, "aube_start")
            h_midi, m_midi = get_hm(sch, "midi_start")
            h_coucher, m_coucher = get_hm(sch, "coucher_start")
            h_nuit, m_nuit = get_hm(sch, "nuit_start")

            w_aube, self.entry_aube_time = time_field(h_aube, m_aube)
            w_midi, self.entry_midi_time = time_field(h_midi, m_midi)
            w_coucher, self.entry_coucher_time = time_field(h_coucher, m_coucher)
            w_nuit, self.entry_nuit_time = time_field(h_nuit, m_nuit)

            rows = [
                (_("tab.schedules.card-shedules.lbl.start-aube"), w_aube),
                (_("tab.schedules.card-shedules.lbl.start-midi"), w_midi),
                (_("tab.schedules.card-shedules.lbl.start-coucher"), w_coucher),
                (_("tab.schedules.card-shedules.lbl.start-night"), w_nuit),
            ]

            for i, (t, w) in enumerate(rows):
                grid.attach(Gtk.Label(label=t, xalign=0), 0, i, 1, 1)
                grid.attach(w, 1, i, 1, 1)

            # -------------------------
            # Auto schedules card
            # -------------------------
            auto_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

            row_auto = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

            lbl_auto = Gtk.Label(label=f"Localisation en cours:", xalign=0)
            lbl_auto.get_style_context().add_class("muted")
            row_auto.pack_start(lbl_auto, True, True, 0)

            self.switch_auto_schedule = Gtk.Switch()
            self.switch_auto_schedule.set_active(bool(self.cfg.get("schedule_auto", False)))
            set_hand_cursor_on_hover(self.switch_auto_schedule)
            self.switch_auto_schedule.connect("notify::active", self._on_schedule_auto_switch)
            self.switch_auto_schedule.get_style_context().add_class("ws-switch")
            row_auto.pack_start(self.switch_auto_schedule, False, False, 0)

            auto_box.pack_start(row_auto, False, False, 0)

            # Geolocation info (city + lat/lon)
            geo_city = ""
            geo_lat = ""
            geo_lon = ""

            try:
                geo_city = (self.city_entry.get_text() or "").strip()
            except Exception:
                pass

            try:
                geo_lat = (self.lat_entry.get_text() or "").strip()
                geo_lon = (self.lon_entry.get_text() or "").strip()
            except Exception:
                pass

            if not geo_city:
                geo_city = (self.cfg.get("geolocation", {}) or {}).get("city_name", "—")

            if not geo_lat or not geo_lon:
                fixed = (self.cfg.get("geolocation", {}) or {}).get("fixed", {})
                if not geo_lat:
                    geo_lat = str(fixed.get("lat", "—"))
                if not geo_lon:
                    geo_lon = str(fixed.get("lon", "—"))

            self.lbl_auto_geoloc = Gtk.Label(
                label=f"{geo_city} ({geo_lat}, {geo_lon})",
                xalign=0,
            )
            self.lbl_auto_geoloc.get_style_context().add_class("muted")
            auto_box.pack_start(self.lbl_auto_geoloc, False, False, 0)

            self._refresh_auto_geoloc_label()

            # Frequency card
            row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            self.spin_minutes = Gtk.SpinButton.new_with_range(1, 240, 1)
            self.spin_minutes.set_value(int(self.cfg.get("timer_minutes", 10)))
            set_hand_cursor_on_hover(self.spin_minutes)

            lbl = Gtk.Label(label=_("tab.schedules.card-frequency.lbl"), xalign=0)
            lbl.get_style_context().add_class("muted")
            row2.pack_start(lbl, False, False, 0)
            row2.pack_start(self.spin_minutes, False, False, 0)

            box.pack_start(make_card("Horaires automatiques", auto_box), False, False, 0)
            box.pack_start(make_card(_("tab.schedules.card-shedules.title"), grid), False, False, 0)
            box.pack_start(make_card(_("tab.schedules.card-frequency.title"), row2), False, False, 0)

            return make_page(box)

