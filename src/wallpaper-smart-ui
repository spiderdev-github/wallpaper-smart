    def refresh_dashboard(self):
        """Update dashboard values from config + last service logs."""
        try:
            # Timer status
            active = is_timer_active()
            self._set_chip(
                self.dash_timer,
                active,
                _("tab.setting.dashboard-card.state-on") if active else _("tab.setting.dashboard-card.state-off"),
            )

            import datetime
            now = datetime.datetime.now()
            now_min = now.hour * 60 + now.minute

            def _parse_time_text(txt: str):
                txt = (txt or "").strip()
                if not txt:
                    return None, None

                if ":" in txt:
                    parts = txt.split(":")
                    if len(parts) != 2:
                        return None, None
                    try:
                        h = int(parts[0].strip() or "0")
                        m = int(parts[1].strip() or "0")
                    except Exception:
                        return None, None
                else:
                    try:
                        h = int(txt)
                    except Exception:
                        return None, None
                    m = 0

                if h < 0:
                    h = 0
                if h > 23:
                    h = 23
                if m < 0:
                    m = 0
                if m > 59:
                    m = 59

                return h, m

            def _get_hm(schedule, key, default_h, default_m):
                v = schedule.get(key, None)

                if isinstance(v, int):
                    return int(v), 0

                if isinstance(v, str):
                    h, m = _parse_time_text(v)
                    if h is None or m is None:
                        return default_h, default_m
                    return h, m

                if isinstance(v, dict):
                    try:
                        h = int(v.get("h", v.get("hour", default_h)))
                        m = int(v.get("m", v.get("minute", default_m)))
                        if h < 0:
                            h = 0
                        if h > 23:
                            h = 23
                        if m < 0:
                            m = 0
                        if m > 59:
                            m = 59
                        return h, m
                    except Exception:
                        return default_h, default_m

                return default_h, default_m

            def _to_min(h, m):
                return int(h) * 60 + int(m)

            def _in_range(t, start, end):
                # True if t in [start, end) on a circular day clock
                if start <= end:
                    return start <= t < end
                return t >= start or t < end

            # Moment (from schedule)
            sch = self.cfg.get("schedule", {}) or {}

            aube_h, aube_m = _get_hm(sch, "aube_start", 5, 0)
            midi_h, midi_m = _get_hm(sch, "midi_start", 11, 0)
            coucher_h, coucher_m = _get_hm(sch, "coucher_start", 17, 0)
            nuit_h, nuit_m = _get_hm(sch, "nuit_start", 19, 0)

            aube_t = _to_min(aube_h, aube_m)
            midi_t = _to_min(midi_h, midi_m)
            coucher_t = _to_min(coucher_h, coucher_m)
            nuit_t = _to_min(nuit_h, nuit_m)

            moment = "nuit"
            if _in_range(now_min, aube_t, midi_t):
                moment = "aube"
            elif _in_range(now_min, midi_t, coucher_t):
                moment = "midi"
            elif _in_range(now_min, coucher_t, nuit_t):
                moment = "coucher"
            else:
                moment = "nuit"

            moment_txt = MOMENT_LABELS.get(moment, moment)
            self.dash_moment.set_text(f"{moment_txt} - {now.strftime('%Hh%M')}")

            # Geoloc summary
            geo = self.cfg.get("geolocation", {})
            mode = geo.get("mode", "auto_ip")
            fixed = geo.get("fixed", {})
            city = geo.get("city_name", "")

            it = None
            try:
                it = self.preset_combo.get_active_iter()
            except Exception:
                it = None

            if it is None:
                preset_id = "none"
            else:
                preset_id = self.preset_store[it][0]

            if not preset_id:
                preset_id = "none"

            if preset_id != "none":
                mode = "preset"
                lat = float(self.preset_store[it][3])
                lon = float(self.preset_store[it][4])
                label = str(self.preset_store[it][1])

            if mode == "preset":
                self.dash_loc.set_text(f"{_('Preset')}: {label} ({lat:.4f}, {lon:.4f})")
            elif mode == "fixed":
                self.dash_loc.set_text(f"{_('Manuel')}: {fixed.get('lat', '—')}, {fixed.get('lon', '—')} - {city}")
            elif mode == "city":
                self.dash_loc.set_text(f"{_('Ville')}: {city}")
            else:
                self.dash_loc.set_text(f"{_('Auto')}: {city} - {fixed.get('lat', '—')}, {fixed.get('lon', '—')} ")

            # Weather + last applied wallpaper (best effort)
            logs = []
            try:
                def _read_time_entry(entry, fallback_h, fallback_m):
                    txt = (entry.get_text() or "").strip()
                    if not txt:
                        return fallback_h, fallback_m
                    h, m = _parse_time_text(txt)
                    if h is None or m is None:
                        return fallback_h, fallback_m
                    return h, m

                def _format_hm(h, m):
                    return f"{int(h):02d}:{int(m):02d}"

                # 1) Build temp config from UI
                cfg = json.loads(json.dumps(self.cfg))

                if hasattr(self, "folder_entry"):
                    cfg["wallpaper_dir"] = self.folder_entry.get_text().strip()

                if hasattr(self, "spin_minutes"):
                    cfg["timer_minutes"] = int(self.spin_minutes.get_value())

                old_sch = cfg.get("schedule", {}) or {}
                aube_h0, aube_m0 = _get_hm(old_sch, "aube_start", 5, 0)
                midi_h0, midi_m0 = _get_hm(old_sch, "midi_start", 11, 0)
                coucher_h0, coucher_m0 = _get_hm(old_sch, "coucher_start", 16, 0)
                nuit_h0, nuit_m0 = _get_hm(old_sch, "nuit_start", 19, 0)

                if hasattr(self, "entry_aube_time"):
                    aube_h1, aube_m1 = _read_time_entry(self.entry_aube_time, aube_h0, aube_m0)
                    midi_h1, midi_m1 = _read_time_entry(self.entry_midi_time, midi_h0, midi_m0)
                    coucher_h1, coucher_m1 = _read_time_entry(self.entry_coucher_time, coucher_h0, coucher_m0)
                    nuit_h1, nuit_m1 = _read_time_entry(self.entry_nuit_time, nuit_h0, nuit_m0)

                    cfg["schedule"] = {
