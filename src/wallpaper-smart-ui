    def _compute_current_moment_key(self) -> str:
        """current moment according to schedule and current time (HH:MM)."""
        from datetime import datetime

        now = datetime.now()
        now_min = now.hour * 60 + now.minute
        sch = self.cfg.get("schedule", {}) or {}

        def _parse_time_text(txt: str):
            txt = (txt or "").strip()
            if not txt:
                return None, None

            if ":" in txt:
                parts = txt.split(":")
                if len(parts) != 2:
                    return None, None
                try:
                    h = int(parts[0].strip() or "0")
                    m = int(parts[1].strip() or "0")
                except Exception:
                    return None, None
            else:
                try:
                    h = int(txt)
                except Exception:
                    return None, None
                m = 0

            if h < 0:
                h = 0
            if h > 23:
                h = 23
            if m < 0:
                m = 0
            if m > 59:
                m = 59

            return h, m

        def _get_hm(schedule, key, default_h, default_m):
            v = schedule.get(key, None)

            if isinstance(v, int):
                return int(v), 0

            if isinstance(v, str):
                h, m = _parse_time_text(v)
                if h is None or m is None:
                    return default_h, default_m
                return h, m

            if isinstance(v, dict):
                try:
                    h = int(v.get("h", v.get("hour", default_h)))
                    m = int(v.get("m", v.get("minute", default_m)))
                    if h < 0:
                        h = 0
                    if h > 23:
                        h = 23
                    if m < 0:
                        m = 0
                    if m > 59:
                        m = 59
                    return h, m
                except Exception:
                    return default_h, default_m

            return default_h, default_m

        def _to_min(h, m):
            return int(h) * 60 + int(m)

        def _in_range(t, start, end):
            # True if t in [start, end) on a circular day clock
            if start <= end:
                return start <= t < end
            return t >= start or t < end

        aube_h, aube_m = _get_hm(sch, "aube_start", 5, 0)
        midi_h, midi_m = _get_hm(sch, "midi_start", 11, 0)
        coucher_h, coucher_m = _get_hm(sch, "coucher_start", 17, 0)
        nuit_h, nuit_m = _get_hm(sch, "nuit_start", 19, 0)

        aube_t = _to_min(aube_h, aube_m)
        midi_t = _to_min(midi_h, midi_m)
        coucher_t = _to_min(coucher_h, coucher_m)
        nuit_t = _to_min(nuit_h, nuit_m)

        if _in_range(now_min, aube_t, midi_t):
            return "aube"
        if _in_range(now_min, midi_t, coucher_t):
            return "midi"
        if _in_range(now_min, coucher_t, nuit_t):
            return "coucher"
        return "nuit"


