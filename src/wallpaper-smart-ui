    def _code_to_emoji(self, code: int) -> str:
        try:
            c = int(code)
        except Exception:
            c = 0

        if c == 0:
            return "☀️"
        if c in [1, 2, 3]:
            return "☁️"
        if c in [45, 48]:
            return "🌫️"
        if c in [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82]:
            return "🌧️"
        if c in [71, 73, 75, 77, 85, 86]:
            return "❄️"
        if c in [95, 96, 99]:
            return "⛈️"
        return "☀️"


    def _timer_refresh_preset_icons(self):
        self.refresh_preset_icons_async()
        return True

    def refresh_preset_icons_async(self):
        # Run once, avoid heavy polling
        if not hasattr(self, "preset_store"):
            return

        def worker():
            for row in self.preset_store:
                pid = row[0]
                if pid == "none":
                    continue
                lat = float(row[3])
                lon = float(row[4])

                code = 0
                try:
                    url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=weather_code"
                    obj = _http_json(url, timeout=4)
                    cur = obj.get("current") or {}
                    code = int(cur.get("weather_code") or 0)
                except Exception:
                    code = 0

                emoji = self._code_to_emoji(code)

                def apply_update(pid_local: str, emoji_local: str):
                    it = self.preset_store.get_iter_first()
                    while it:
                        if self.preset_store[it][0] == pid_local:
                            self.preset_store[it][2] = emoji_local
                            break
                        it = self.preset_store.iter_next(it)
                    return False

                GLib.idle_add(apply_update, pid, emoji)

        th = threading.Thread(target=worker, daemon=True)
        th.start()
        
