def disable_scroll_change(widget):
    """
    Disable mouse wheel changing values on ComboBox/ComboBoxText.
    Prevents accidental changes when user scrolls the window.
    """
    widget.connect("scroll-event", lambda _w, _e: True)

def set_hand_cursor_on_hover(widget):
    widget.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)

    def on_enter(w, _e):
        win = w.get_window()
        if win:
            win.set_cursor(Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "pointer"))
        return False

    def on_leave(w, _e):
        win = w.get_window()
        if win:
            win.set_cursor(None)
        return False

    widget.connect("enter-notify-event", on_enter)
    widget.connect("leave-notify-event", on_leave)

def _detect_system_lang() -> str:
    # Try LANG=fr_FR.UTF-8 -> fr_FR
    try:
        lang = os.environ.get("LANG", "") or ""
        if "." in lang:
            lang = lang.split(".", 1)[0]
        if lang:
            return lang
    except Exception:
        pass

    # Fallback locale module
    try:
        loc = locale.getdefaultlocale()[0]
        if loc:
            return loc
    except Exception:
        pass

    return APP_LANG_DEFAULT


def _load_lang_file(lang_dir: Path, code: str) -> dict:
    p = lang_dir / f"{code}.json"
    try:
        if p.exists():
            return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {}


def init_i18n_json(cfg: dict, lang_dir: Path | None = None) -> None:
    global _tr, _tr_fallback

    custom = APP_DIR / "lang"
    if custom.exists():
        lang_dir = custom

    ui = cfg.get("ui", {}) if isinstance(cfg.get("ui", {}), dict) else {}
    lang = str(ui.get("language", "system") or "system").strip()

    if not lang_dir:
        # lang folder next to this script
        here = Path(__file__).resolve().parent
        lang_dir = here / "lang"

    if lang == "system" or not lang:
        lang = _detect_system_lang()

    # Load fallback first
    _tr_fallback = _load_lang_file(lang_dir, APP_LANG_DEFAULT)

    # Load selected lang
    _tr = _load_lang_file(lang_dir, lang)

    # If selected file not found, keep fallback
    if not _tr:
        _tr = dict(_tr_fallback)


def fetch_weather_code(lat: float, lon: float, timeout: int = 3) -> int:
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}&current=weather_code"
    )
    d = _http_json(url, timeout=timeout)
    cur = d.get("current") or {}
    return int(cur.get("weather_code") or 0)


def fetch_weather_with_temp(lat: float, lon: float, timeout: int = 3) -> Tuple[int, float]:
    """Fetch weather code and temperature from Open-Meteo API.
    Returns: (weather_code, temperature_celsius)
    """
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}&current=weather_code,temperature_2m"
    )
    d = _http_json(url, timeout=timeout)
    cur = d.get("current") or {}
    code = int(cur.get("weather_code") or 0)
    temp = float(cur.get("temperature_2m") or 0)
    return code, temp


def weather_code_to_bucket(code: int) -> str:
    """Convertit un code météo WMO en bucket (clear, cloudy, fog, rain, snow, thunder)"""
    if code == 0 or code == 1:
        return "clear"
    elif code == 2 or code == 3:
        return "cloudy"
    elif code == 45 or code == 48:
        return "fog"
    elif code in range(51, 68) or code in range(80, 83):
        return "rain"
    elif code in range(71, 78) or code in range(85, 87):
        return "snow"
    elif code in range(95, 100):
        return "thunder"
    else:
        return "cloudy"  # fallback


def is_weather_cache_valid(cfg: Dict, lat: float, lon: float, max_age_seconds: int = 600) -> bool:
    """Vérifie si le cache météo est encore valide (moins de 10 minutes et même coordonnées)"""
    import time
    cache = cfg.get("weather_cache", {})
    
    if cache.get("code") is None or cache.get("temp") is None:
        return False
    
    # Vérifier si les coordonnées correspondent
    cached_lat = cache.get("lat")
    cached_lon = cache.get("lon")
    if cached_lat is None or cached_lon is None:
        return False
    if abs(cached_lat - lat) > 0.01 or abs(cached_lon - lon) > 0.01:
        return False
    
    # Vérifier l'ancienneté du cache
    timestamp = cache.get("timestamp", 0)
    age = time.time() - timestamp
    return age < max_age_seconds


def update_weather_cache(cfg: Dict, code: int, temp: float, lat: float, lon: float):
    """Met à jour le cache météo dans la config et sauvegarde dans le fichier"""
    import time
    cfg["weather_cache"] = {
        "code": code,
        "temp": temp,
        "timestamp": time.time(),
        "lat": lat,
        "lon": lon
    }
    # Sauvegarder dans le fichier config
    try:
        with open(CFG_PATH, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2, ensure_ascii=False)
    except Exception as e:
        debug_print(f"Erreur lors de la sauvegarde du cache météo: {e}")


def get_cached_weather(cfg: Dict) -> Tuple[int | None, float | None]:
    """Récupère les données météo depuis le cache"""
    cache = cfg.get("weather_cache", {})
    return cache.get("code"), cache.get("temp")


def country_code_to_flag(country_code: str) -> str:
    """Convertit un code pays ISO (2 lettres) en emoji drapeau
    Exemple: 'FR' -> '🇫🇷', 'US' -> '🇺🇸'
    """
    if not country_code or len(country_code) != 2:
        return ""

    # Les emojis de drapeaux utilisent des Regional Indicator Symbols
    # A = U+1F1E6, B = U+1F1E7, ..., Z = U+1F1FF
    return ''.join(chr(0x1F1E6 + ord(char) - ord('A')) for char in country_code.upper())


