        path = dlg.get_filename()
    dlg.destroy()
    return path

def load_pixbuf_scaled(path: Path, max_w=420, max_h=240):
    if not path.exists():
        return None
    pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
    w, h = pb.get_width(), pb.get_height()
    scale = min(max_w / w, max_h / h)
    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))
    return pb.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)

def generate_thumbnail(src: Path, dst: Path, thumb_max_w=200, thumb_max_h=150):
    """Génère une miniature de l'image source et la sauvegarde dans un dossier thumbnails"""
    if not src.exists():
        return
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file(str(src))
        w, h = pb.get_width(), pb.get_height()
        scale = min(thumb_max_w / w, thumb_max_h / h)
        new_w = max(1, int(w * scale))
        new_h = max(1, int(h * scale))
        thumb_pb = pb.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)
        
        # Créer le dossier .thumbnails
        thumb_dir = dst.parent / "thumbnails"
        thumb_dir.mkdir(parents=True, exist_ok=True)
        thumb_path = thumb_dir / dst.name
        
        # Sauvegarder la miniature en PNG
        thumb_pb.savev(str(thumb_path), "png", [], [])
    except Exception as e:
        print(f"Erreur lors de la génération de la miniature: {e}")

def get_thumbnail_path(image_path: Path) -> Path:
    """Retourne le chemin de la miniature pour une image"""
    return image_path.parent / "thumbnails" / image_path.name

