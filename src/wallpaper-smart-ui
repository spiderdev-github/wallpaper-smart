    def _fill_from_auto_ip(self):
        """Remplit Lat/Lon/Ville depuis l'IP (UI uniquement, sans sauvegarde)."""
        try:
            self.lat_entry.set_text("")
            self.lon_entry.set_text("")
            self.city_entry.set_text("")

            if hasattr(self, "_hid_preset_changed"):
                self.preset_combo.handler_block(self._hid_preset_changed)

            self.preset_combo.set_active(0)  # solution 2: no selection

            if hasattr(self, "_hid_preset_changed"):
                self.preset_combo.handler_unblock(self._hid_preset_changed)

            d = _auto_ip_details()
            
            # si auto-ip failed
            if not isinstance(d, dict) or ("lat" not in d) or ("lon" not in d):
                err_txt = ""
                if isinstance(d, dict):
                    err_txt = str(d.get("_error", "")).strip()

                # fallback au cas ou err_txt vide
                if not err_txt:
                    err_txt = _("Service indisponible")

                self.message(
                    "Geoloc auto indisponible",
                    "Impossible de recuperer ta localisation automatiquement (auto_ip).\n\n"
                    "Cause probable: limite temporaire du service.\n"
                    "Attends 1-2 minutes puis reessaie.\n\n"
                    "Astuce: utilise un preset ou passe en mode fixed.\n\n"
                    f"Details: {err_txt}"
                )
                return


            if "lat" in d and hasattr(self, "lat_entry"):
                self.lat_entry.set_text(f"{d['lat']:.4f}")
            if "lon" in d and hasattr(self, "lon_entry"):
                self.lon_entry.set_text(f"{d['lon']:.4f}")
            
            if hasattr(self, "city_entry"):
                city = str(d.get("city") or "").strip()
                region = str(d.get("region") or "").strip()
                country = str(d.get("country") or "").strip()
                label = city
                if region and region not in label:
                    label = (label + f", {region}") if label else region
                if country and country not in label:
                    label = (label + f", {country}") if label else country
                if label:
                    self.city_entry.set_text(label)
        except Exception:
            pass

    def on_geo_mode_changed(self, _combo):
        """When user changes mode, adjust UI and preset."""
        # If user leaves fixed mode, reset preset to none (ergonomic)
        mode = self.geo_combo.get_active_id()
        if mode != "fixed" and hasattr(self, "preset_combo"):
            # block preset change handler while updating
            self.preset_combo.set_active(0)
        if mode == "auto_ip":
            self._fill_from_auto_ip()

        if mode == "fixed":
            if hasattr(self, "_hid_preset_changed"):
                self.preset_combo.handler_block(self._hid_preset_changed)

            self.preset_combo.set_active(0)  # solution 2: no selection

            if hasattr(self, "_hid_preset_changed"):
                self.preset_combo.handler_unblock(self._hid_preset_changed)
        
        self.refresh_geoloc_controls()
        try:
            if self.geo_combo.get_active_text() == "city":
                self.city_entry.grab_focus()
        except Exception:
            pass



    def on_geo_preset_changed(self, _combo):
        preset_id = "none"

        it = None
        try:
            it = self.preset_combo.get_active_iter()
        except Exception:
            it = None

        if it is None:
            preset_id = "none"
        else:
            preset_id = self.preset_store[it][0]

        if not preset_id:
            preset_id = "none"

        if preset_id != "none":
            lat = float(self.preset_store[it][3])
            lon = float(self.preset_store[it][4])
            label = str(self.preset_store[it][1])

            self.lat_entry.set_text(f"{lat:.4f}")
            self.lon_entry.set_text(f"{lon:.4f}")

            # Clean city field (remove flag + meteo icon at end if any)
            pretty = label
            for flag in ["🇷🇺","🇺🇸","🇮🇸","🇸🇬","🇦🇪","🇯🇵","🇦🇺","🇲🇦","🇫🇷","🇩🇪","🇪🇸","🇮🇹","🇬🇧","🇨🇦","🇧🇷","🇲🇽","🇿🇦","🇮🇳","🇨🇳"]:
