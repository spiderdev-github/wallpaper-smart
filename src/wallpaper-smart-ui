    def rebuild_images_tab(self, focus: bool = True):
        """Rebuild the Images tab safely (keeps its position, no fixed index)."""
        try:
            insert_at = -1
            if hasattr(self, "images_tab"):
                insert_at = self.nb.page_num(self.images_tab)
                if insert_at != -1:
                    self.nb.remove_page(insert_at)

            self.images_tab = self.build_tab_images()
            tab_label = make_tab_label("Images", "image-x-generic-symbolic")

            if insert_at != -1:
                self.nb.insert_page(self.images_tab, tab_label, insert_at)
            else:
                self.nb.append_page(self.images_tab, tab_label)

            self.nb.show_all()

            if focus:
                idx = self.nb.page_num(self.images_tab)
                if idx != -1:
                    self.nb.set_current_page(idx)
        except Exception as e:
            self.message("Erreur", f"{_('Impossible de reconstruire l\'onglet Images')}\n{e}")

    def refresh_toggle_label(self):
        self.btn_toggle.set_label(_("btn.tolggle.off") if is_timer_active() else _("btn.tolggle.on"))

    def message(self, title, text):
        dlg = Gtk.MessageDialog(self, 0, Gtk.MessageType.INFO, Gtk.ButtonsType.OK, title)
        dlg.format_secondary_text(text)
        dlg.set_default_size(860, 480)
        dlg.run()
        dlg.destroy()

    def on_toggle_image_enabled(self, widget, *args):
        """Instant-save: enable/disable one meteo image.

        Compatible with:
          - Gtk.Switch notify::active -> (switch, pspec, rel_path)
          - Gtk.CheckButton toggled   -> (checkbutton, rel_path)
        """
        try:
            rel_path = None
            if len(args) == 1:
                rel_path = args[0]
            elif len(args) >= 2:
                rel_path = args[1]
            if not rel_path:
                return

