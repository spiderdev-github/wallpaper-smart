def generate_missing_thumbnails_for_theme(theme_dir: Path):
    """Génère les miniatures manquantes pour tous les PNG d'un thème"""
    try:
        # Parcourir dark et light
        for style_dir in [theme_dir / "dark", theme_dir / "light"]:
            if not style_dir.exists():
                continue
            
            # Parcourir base et meteo
            for sub_dir in [style_dir / "base", style_dir / "meteo"]:
                if not sub_dir.exists():
                    continue
                
                # Trouver tous les fichiers PNG
                for image_file in sub_dir.glob("*.png"):
                    thumb_path = get_thumbnail_path(image_file)
                    # Générer la miniature si elle n'existe pas
                    if not thumb_path.exists():
                        generate_thumbnail(image_file, image_file)
    except Exception as e:
        print(f"Erreur lors de la génération des miniatures pour {theme_dir}: {e}")

def load_wallpaper_themes(wallpaper_dir: str) -> List[Tuple[str, str]]:
    root = Path(wallpaper_dir).expanduser()

    mode = "dark" if detect_dark_mode() else "light"

    troot = root / "templates"
    out: List[Tuple[str, str]] = []

    if not troot.exists():
        return [("default", "Defaut")]

    required = ["aube.png", "midi.png", "coucher.png", "nuit.png"]

    for d in sorted([p for p in troot.iterdir() if p.is_dir()]):
        theme_id = d.name

        
        base_dir = d / mode / "base"
        if not base_dir.is_dir():
            continue

        ok = True
        for fn in required:
            if not (base_dir / fn).is_file():
                ok = False
                break
        if not ok:
            continue

        label = theme_id

        meta = d / "theme.json"
        if meta.is_file():
            try:
                data = json.loads(meta.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    name = str(data.get("name") or "").strip()
                    if name:
                        label = name
            except Exception:
                pass

        out.append((theme_id, label))
        
        # Générer les miniatures manquantes pour ce thème
        generate_missing_thumbnails_for_theme(d)

    if not out:
        return [("default", "Defaut")]

    return out


def _http_json(url: str, timeout: int = 5) -> Dict[str, Any]:
    """
    Fetch JSON from URL with a hard timeout (synchronous).
    Raises exceptions on HTTP/network/JSON errors.
    """
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "wallpaper-smart/1.0",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace") if hasattr(e, "read") else ""
        raise RuntimeError(f"HTTPError {e.code} on {url}: {body[:200]}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"URLError on {url}: {e.reason}") from e
    except socket.timeout as e:
        raise RuntimeError(f"Timeout after {timeout}s on {url}") from e

    obj = json.loads(raw)
    if not isinstance(obj, dict):
        raise RuntimeError(f"Expected JSON object, got {type(obj).__name__}")
    return obj


def _http_json_async(url: str, callback, timeout: int = 5):
    """
    Fetch JSON from URL asynchronously using ThreadPoolExecutor.
    Calls callback(result: Dict | None, error: str | None) on GTK main thread.
    """
    def _fetch():
        try:
            result = _http_json(url, timeout=timeout)
            GLib.idle_add(lambda res=result: callback(res, None))
        except Exception as e:
            error_msg = str(e)
            GLib.idle_add(lambda err=error_msg: callback(None, err))
    
    _http_executor.submit(_fetch)


def fetch_weather_code_async(lat: float, lon: float, callback, timeout: int = 3):
    """
    Fetch weather code asynchronously.
    Calls callback(code: int | None, error: str | None) on GTK main thread.
    """
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}&current=weather_code"
    )
    
    def _on_result(result, error):
        if error:
            callback(None, error)
        else:
            try:
                cur = result.get("current") or {}
                code = int(cur.get("weather_code") or 0)
                callback(code, None)
            except Exception as e:
                callback(None, str(e))
    
    _http_json_async(url, _on_result, timeout=timeout)


