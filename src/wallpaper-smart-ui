    def _rel_swap_style(self, rel: str, style: str) -> str:
        parts = list(Path(rel).parts)

        # Replace first occurrence of dark/light anywhere in the path
        for i, part in enumerate(parts):
            if part in ("dark", "light"):
                parts[i] = style
                return str(Path(*parts))

        return rel

    def _rel_swap_theme(self, rel: str, theme: str) -> str:
        parts = list(Path(rel).parts)

        # Look for ".../templates/<theme>/..."
        for i in range(len(parts) - 1):
            if parts[i] == "templates":
                parts[i + 1] = theme
                return str(Path(*parts))

        return rel



