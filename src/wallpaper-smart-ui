    def _get_current_coordinates(self):
        """Récupère les coordonnées actuelles basées sur le mode de géolocalisation
        Returns: (lat, lon, city, country_code)
        """
        try:
            geo = self.cfg.get("geolocation", {})
            mode = geo.get("mode", "auto_ip")

            if mode == "fixed":
                fixed = geo.get("fixed", {})
                lat = fixed.get("lat")
                lon = fixed.get("lon")
                city = geo.get("city_name", "")
                country_code = geo.get("country_code", "")
                if lat is not None and lon is not None:
                    return float(lat), float(lon), city, country_code
            elif mode == "auto_ip":
                # Récupérer via IP
                details = _auto_ip_details()
                if "lat" in details and "lon" in details:
                    lat = details["lat"]
                    lon = details["lon"]
                    city = details.get("city", geo.get("city_name", ""))
                    country_code = details.get("country_code", "")

                    # Sauvegarder les coordonnées réussies pour usage futur
                    try:
                        geo.setdefault("last_known_coordinates", {})
                        geo["last_known_coordinates"]["lat"] = lat
                        geo["last_known_coordinates"]["lon"] = lon
                        geo["last_known_coordinates"]["city"] = city
                        geo["last_known_coordinates"]["country_code"] = country_code
                        save_cfg(self.cfg)
                        debug_print(f"Coordonnées sauvegardées: lat={lat}, lon={lon}, city={city}, country={country_code}")
                    except Exception as save_err:
                        debug_print(f"Erreur lors de la sauvegarde des coordonnées: {save_err}")

                    return float(lat), float(lon), str(city), str(country_code)
                else:
                    # Fallback 1: Essayer les dernières coordonnées connues
                    last_known = geo.get("last_known_coordinates", {})
                    if "lat" in last_known and "lon" in last_known:
                        lat = last_known["lat"]
                        lon = last_known["lon"]
                        city = last_known.get("city", "")
                        country_code = last_known.get("country_code", "")
                        debug_print(f"Utilisation des dernières coordonnées connues: lat={lat}, lon={lon}, city={city}")
                        return float(lat), float(lon), str(city), str(country_code)

                    # Fallback 2: Essayer les coordonnées fixes si disponibles
                    fixed = geo.get("fixed", {})
                    if "lat" in fixed and "lon" in fixed:
                        lat = fixed["lat"]
                        lon = fixed["lon"]
                        city = geo.get("city_name", "")
                        country_code = geo.get("country_code", "")
                        debug_print(f"Utilisation des coordonnées fixes comme fallback: lat={lat}, lon={lon}, city={city}")
                        return float(lat), float(lon), str(city), str(country_code)

            # Fallback sur les coordonnées par défaut
            return None, None, "", ""
        except Exception as e:
            debug_print(f"Erreur lors de la récupération des coordonnées: {e}")
            return None, None, "", ""

    def _update_indicator_weather(self):
        """Met à jour le label de l'indicateur avec la météo actuelle"""
        try:
            if not HAS_APPINDICATOR or not self.indicator:
                return True

            # Vérifier que la config est chargée
            if not hasattr(self, 'cfg'):
                return True

            # Récupérer les coordonnées
            lat, lon, city, country_code = self._get_current_coordinates()

            if lat is None or lon is None:
                # Pas de coordonnées disponibles
                self.indicator.set_label("", "")
                return True

            # Générer le drapeau
            flag = country_code_to_flag(country_code) if country_code else ""

            # Fonction pour mettre à jour l'affichage avec les données météo
            def update_display(code, temp):
                try:
                    # Convertir en bucket
                    bucket = weather_code_to_bucket(code)

                    # Récupérer l'emoji et le nom
                    meteo_txt, emoji = BUCKET_LABELS.get(bucket, (bucket, "🌡️"))

                    # Vérifier si on doit afficher la température
                    show_temp = self.cfg.get("show_temperature_in_tray", False)

                    # Construire le label
                    if show_temp and temp is not None:
                        temp_str = f"{temp:.0f}°C"
                        if city:
                            label = f"{temp_str} {emoji} {flag} {city}".strip()
                        else:
                            label = f"{temp_str} {emoji} {meteo_txt}".strip()
                    else:
                        if city:
                            label = f"{emoji} {flag} {city}".strip()
                        else:
                            label = f"{emoji} {meteo_txt}".strip()

                    # Mettre à jour l'indicateur
                    self.indicator.set_label(label, label)
                    self.indicator.set_title(label)
                except Exception as e:
                    debug_print(f"Erreur lors de la mise à jour du label: {e}")

            # Vérifier si le cache est valide (moins de 10 minutes)
            if is_weather_cache_valid(self.cfg, lat, lon, max_age_seconds=600):
                # Utiliser les données du cache
                cached_code, cached_temp = get_cached_weather(self.cfg)
                if cached_code is not None:
                    debug_print("Utilisation du cache météo")
                    update_display(cached_code, cached_temp)
            else:
                # Le cache n'est pas valide, faire un appel API
                debug_print("Cache météo invalide, appel API")
                
                def on_weather_result(code, temp, error):
                    if error:
                        debug_print(f"Erreur météo dans indicateur: {error}")
                        # En cas d'erreur, essayer d'utiliser le cache même s'il est ancien
                        cached_code, cached_temp = get_cached_weather(self.cfg)
                        if cached_code is not None:
                            debug_print("Utilisation du cache périmé en raison d'une erreur API")
                            update_display(cached_code, cached_temp)
                        return
                    
                    try:
                        # Mettre à jour le cache avec les nouvelles données
                        update_weather_cache(self.cfg, code, temp, lat, lon)
                        debug_print(f"Cache météo mis à jour: code={code}, temp={temp}°C")
                        
                        # Mettre à jour l'affichage
                        update_display(code, temp)
                    except Exception as e:
                        debug_print(f"Erreur lors de la mise à jour: {e}")

                # Toujours récupérer la température même si show_temperature_in_tray est False
                # Cela permet d'avoir les données en cache pour plus tard
                fetch_weather_with_temp_async(lat, lon, on_weather_result, timeout=5)

        except Exception as e:
            debug_print(f"Erreur lors de la mise à jour de la météo: {e}")
            import traceback
            debug_print(traceback.format_exc())

        return True  # Retourner True pour que le timer continue

