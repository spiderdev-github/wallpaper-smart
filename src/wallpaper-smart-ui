    def refresh_images_preview(self):
        root = Path(self.folder_entry.get_text().strip())
        enabled_map = self.cfg.get("enabled_images", {})

        # --- Base previews (left) ---
        moment_now = None
        try:
            moment_now = self._compute_current_moment_key()
        except Exception:
            moment_now = None

        if getattr(self, "base_rows", None):
            for moment_key, (_row, img_widget, path_lbl, chip_lbl, current_chip) in self.base_rows.items():
                rel = self._rel_path("base", f"{moment_key}.png")
                p = root / rel 
                exists = p.exists()

                path_lbl.set_text(str(p) if exists else f"{p} ({_('tab.images.card-meteo.state-nofound-low')})")
                pb = load_pixbuf_scaled(p) if exists else None
                if pb:
                    img_widget.set_from_pixbuf(pb)
                else:
                    img_widget.clear()

                ctx = chip_lbl.get_style_context()
                ctx.remove_class("chip-ok")
                ctx.remove_class("chip-miss")
                if exists:
                    chip_lbl.set_text("OK")
                    ctx.add_class("chip-ok")
                else:
                    chip_lbl.set_text(_("tab.images.card-meteo.state-nofound-upper"))
                    ctx.add_class("chip-miss")

                if current_chip is not None:
                    if moment_now and moment_key == moment_now:
                        current_chip.show()
                    else:
                        current_chip.hide()

        # --- Meteo previews (right) ---
        for rel, (img_widget, path_lbl, chip_lbl, active_sw) in getattr(self, "image_widgets", {}).items():
            p = root / rel
            exists = p.exists()

            enabled = bool(enabled_map.get(rel, True))
            hid = getattr(active_sw, "_hid_active", None)
            if hid is not None:
                active_sw.handler_block(hid)
            active_sw.set_active(enabled)
            if hid is not None:
                active_sw.handler_unblock(hid)

            path_lbl.set_text(str(p) if exists else f"{p} ({_('manquant')})")
            pb = load_pixbuf_scaled(p) if exists else None
            if pb:
                img_widget.set_from_pixbuf(pb)
            else:
                img_widget.clear()

            ctx = chip_lbl.get_style_context()
            ctx.remove_class("chip-ok")
            ctx.remove_class("chip-miss")
            if exists:
                chip_lbl.set_text("OK")
                ctx.add_class("chip-ok")
            else:
                chip_lbl.set_text("MANQUANT")
                ctx.add_class("chip-miss")

        # Re-apply filter after refresh
        moment = getattr(self, "images_selected_moment", None) or None
        if not moment:
            moment = moment_now
        if moment:
            self.images_selected_moment = moment
            self.apply_meteo_filter(moment)


