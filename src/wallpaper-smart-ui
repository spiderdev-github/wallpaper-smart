def prettify_meteo_value_log(line: str) -> str:
    """
    Convert a raw wallpaper-smart.sh journal line into a user-friendly text.
    Expected pattern inside line:
      moment=... | bucket=... | prefix=... | candidate=... | code=... | LAT=... LON=...
    """
    import re

    m = re.search(
        r"moment=(\w+)\s*\|\s*bucket=(\w+)\s*\|\s*prefix=([^\s|]+)\s*\|\s*candidate=(\w+)\s*\|\s*code=(\d+)\s*\|\s*LAT=([-\d.]+)\s*LON=([-\d.]+)",
        line,
    )

    # If no match, keep it short but still readable
    if not m:
        s = (line or "").strip()
        if len(s) > 250:
            s = s[:250] + "…"
        return s or "—"

    moment, bucket, _prefix, candidate, code, lat, lon = m.groups()

    return _prefix


