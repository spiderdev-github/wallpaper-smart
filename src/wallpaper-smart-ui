    def refresh_dashboard(self):
        """Update dashboard values from config + last service logs."""
        try:
            # Timer status
            active = is_timer_active()
            self._set_chip(self.dash_timer, active, _("tab.setting.dashboard-card.state-on") if active else _("tab.setting.dashboard-card.state-off"))

            # Moment (from schedule)
            import datetime
            now = datetime.datetime.now()
            hour = now.hour
            sch = self.cfg.get("schedule", {})
            nuit = int(sch.get("nuit_start", 19))
            aube = int(sch.get("aube_start", 5))
            midi = int(sch.get("midi_start", 11))
            coucher = int(sch.get("coucher_start", 17))

            moment = "nuit"
            if aube <= hour < midi:
                moment = "aube"
            elif midi <= hour < coucher:
                moment = "midi"
            else:
                # coucher window depends on nuit start
                if coucher < nuit:
                    moment = "coucher" if coucher <= hour < nuit else "nuit"
                else:
                    moment = "coucher" if (hour >= coucher or hour < nuit) else "nuit"

            moment_txt = MOMENT_LABELS.get(moment, moment)
            self.dash_moment.set_text(f"{moment_txt} - {now.strftime('%Hh%M')}")

            # Geoloc summary
            geo = self.cfg.get("geolocation", {})
            mode = geo.get("mode", "auto_ip")
            preset = geo.get("preset", "none")
            fixed = geo.get("fixed", {})
            city = geo.get("city_name", "")
            
            it = None
            try:
                it = self.preset_combo.get_active_iter()
            except Exception:
                it = None


            if it is None:
                preset_id = "none"
            else:
                preset_id = self.preset_store[it][0]

            if not preset_id:
                preset_id = "none"

            if preset_id != "none":
                mode = "preset"
                lat = float(self.preset_store[it][3])
                lon = float(self.preset_store[it][4])
                label = str(self.preset_store[it][1])
                
            if mode == "preset":
                self.dash_loc.set_text(f"{_("Preset")}: {label} ({lat:.4f}, {lon:.4f})")
            elif mode == "fixed":
                self.dash_loc.set_text(f"{_("Manuel")}: {fixed.get('lat', '—')}, {fixed.get('lon', '—')} - {city}")
            elif mode == "city":
                self.dash_loc.set_text(f"{_("Ville")}: {city}")
            else:
                self.dash_loc.set_text(f"{_("Auto")}: {city} - {fixed.get('lat', '—')}, {fixed.get('lon', '—')} ")
            # Weather + last applied wallpaper from journalctl (best effort)
            #p = run(["journalctl", "--user", "-u", SERVICE, "-n", "80", "--no-pager"])
            #logs = p.stdout.splitlines()

            try:
                # 1) Construire une config temporaire depuis l'UI (sans sauvegarder la vraie)
                cfg = json.loads(json.dumps(self.cfg))  # copie safe

                # Wallpaper dir
                if hasattr(self, "folder_entry"):
                    cfg["wallpaper_dir"] = self.folder_entry.get_text().strip()

                # Timer
                if hasattr(self, "spin_minutes"):
                    cfg["timer_minutes"] = int(self.spin_minutes.get_value())

                # Schedule
                if hasattr(self, "spin_nuit"):
                    cfg["schedule"] = {
                        "nuit_start": int(self.spin_nuit.get_value()),
                        "aube_start": int(self.spin_aube.get_value()),
                        "midi_start": int(self.spin_midi.get_value()),
                        "coucher_start": int(self.spin_coucher.get_value()),
                    }

                # Geoloc (mode + lat/lon + city + preset)
                cfg.setdefault("geolocation", {})
                if hasattr(self, "geo_combo"):
                    cfg["geolocation"]["mode"] = self.geo_combo.get_active_id()

                if hasattr(self, "lat_entry") and hasattr(self, "lon_entry"):
                    try:
                        cfg["geolocation"].setdefault("fixed", {})
                        cfg["geolocation"]["fixed"]["lat"] = float(self.lat_entry.get_text().strip())
                        cfg["geolocation"]["fixed"]["lon"] = float(self.lon_entry.get_text().strip())
                    except Exception:
                        pass

                if hasattr(self, "city_entry"):
                    cfg["geolocation"]["city_name"] = self.city_entry.get_text().strip()

                if hasattr(self, "preset_combo"):
                    # value stored in combo id
                    preset_id = self.preset_combo.get_active_id() or "none"
                    cfg["geolocation"]["preset"] = preset_id

                # Mapping
                if hasattr(self, "map_entries"):
                    cfg.setdefault("weather_mapping", {})
                    for k, e in self.map_entries.items():
                        cfg["weather_mapping"][k] = e.get_text().strip()

                # enabled_images
                cfg.setdefault("enabled_images", self.cfg.get("enabled_images", {}))

                # 2) Ecrire config temporaire
                tmp = APP_DIR / "config.test.json"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(cfg, f, indent=2, ensure_ascii=False)

                # 3) Lancer wallpaper-smart.sh avec la config temporaire
                script = Path.home() / ".local/bin/wallpaper-smart.sh"
                p = subprocess.run(
                    [str(script)],
                    text=True,
                    capture_output=True,
                    env={**os.environ, "CONFIG_FILE": str(tmp)},
                )

                logs = p.stdout.splitlines()
            except Exception as e:
                self.message("Erreur test", str(e))

            wall_line = None
            meta_line = None
            for line in reversed(logs):
                if "✅ Wallpaper:" in line or "Wallpaper:" in line:
                    wall_line = line.strip()
                    break
            for line in reversed(logs):
                if "moment=" in line and "code=" in line:
                    meta_line = line.strip()
                    break
                    
            if meta_line:
                self.dash_meteo.set_text(prettify_meteo_log(meta_line))
            else:
                self.dash_meteo.set_text("—")

            if wall_line:
                self.dash_wall.set_text(prettify_wallpaper_log(wall_line))
            else:
                # fallback: current.png path
                wdir = self.cfg.get("wallpaper_dir", str(Path.home() / "Images" / "wallpaper"))
                cur = Path(wdir) / "current.png"
                self.dash_wall.set_text(str(cur) if cur.exists() else "—")
        except Exception as e:
            # Don't crash the UI for dashboard refresh
            try:
                self.dash_meteo.set_text(f"Erreur dashboard: {e}")
            except Exception:
                pass

