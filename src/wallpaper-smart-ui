def prettify_wallpaper_log(line: str) -> str:
    """
    Extract only the wallpaper path from a wallpaper-smart.sh log line
    and return a friendly text with an image icon.
    Example output:
      🖼️ /home/user/Images/wallpaper/meteo/neige_midi.png
    """
    import re

    m = re.search(r"\bWallpaper:\s*([^\s]+)", line)

    # If no match, keep it short but still readable
    if not m:
        s = (line or "").strip()
        if len(s) > 160:
            s = s[:160] + "…"
        return s or "—"

    wallpaper_path = m.group(1)

    m = re.search(
        r"moment=(\w+)\s*\|\s*bucket=(\w+)\s*\|\s*prefix=([^\s|]+)\s*\|\s*candidate=(\w+)\s*\|\s*code=(\d+)\s*\|\s*LAT=([-\d.]+)\s*LON=([-\d.]+)",
        line,
    )

    # If no match, keep it short but still readable
    if not m:
        s = (line or "").strip()
        if len(s) > 250:
            s = s[:250] + "…"
        return s or "—"

    moment, bucket, _prefix, candidate, code, lat, lon = m.groups()
    if(candidate == "no"):
        # icon attention
        ICON = "⚠️ "
        # ajouter un message d'erreur à la ligne   
        err = _("tab.setting.dashboard-card.lbl-error")
        return f"{ICON} {wallpaper_path}\n({err})"
    else:
        ICON = "✅ "
        return f"{ICON} {wallpaper_path}"


# ---------------- Helpers ----------------

def run(cmd, check=False):
    p = subprocess.run(cmd, text=True, capture_output=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)}\n{p.stderr.strip()}")
    return p

def load_cfg():
    APP_DIR.mkdir(parents=True, exist_ok=True)
    if not CFG_PATH.exists():
        save_cfg(DEFAULT_CFG)
    with open(CFG_PATH, "r", encoding="utf-8") as f:
        cfg = json.load(f)

    # upgrade-soft
    if "enabled_images" not in cfg or not isinstance(cfg["enabled_images"], dict):
        cfg["enabled_images"] = {}
        save_cfg(cfg)

    # upgrade-soft: geolocation preset
    if "geolocation" not in cfg or not isinstance(cfg.get("geolocation"), dict):
        cfg["geolocation"] = DEFAULT_CFG["geolocation"].copy()
        save_cfg(cfg)
    if "preset" not in cfg["geolocation"]:
        cfg["geolocation"]["preset"] = "none"
        save_cfg(cfg)

    return cfg

def save_cfg(cfg):
    # Sauvegarde de la config
    APP_DIR.mkdir(parents=True, exist_ok=True)
    with open(CFG_PATH, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    
    # Suppression de l'etat courant pour forcer le reload
    if os.path.exists(CURRENT_PATH):
        try:
            os.remove(CURRENT_PATH)
        except OSError:
            pass

def ensure_overrides(cfg):
    user_systemd = Path.home() / ".config" / "systemd" / "user"
    (user_systemd / f"{SERVICE}.d").mkdir(parents=True, exist_ok=True)
    (user_systemd / f"{TIMER}.d").mkdir(parents=True, exist_ok=True)

    (user_systemd / f"{SERVICE}.d" / "override.conf").write_text(
        "[Service]\n"
        f"Environment=CONFIG_FILE={CFG_PATH}\n"
        "ExecStartPre=/bin/sleep 5\n",

        encoding="utf-8"
    )

    minutes = int(cfg.get("timer_minutes", 10))
    (user_systemd / f"{TIMER}.d" / "override.conf").write_text(
        "[Timer]\n"
        "OnStartupSec=10s\n"
        f"OnUnitActiveSec={minutes}min\n"
        "Persistent=true\n",
        encoding="utf-8"
    )

    run(["systemctl", "--user", "daemon-reload"])

def is_timer_active():
    p = run(["systemctl", "--user", "is-active", TIMER])
    return p.returncode == 0 and p.stdout.strip() == "active"

def set_timer(enabled: bool):
    if enabled:
        run(["systemctl", "--user", "enable", "--now", TIMER], check=True)
    else:
        run(["systemctl", "--user", "disable", "--now", TIMER], check=True)

def pick_file(parent, title, initial_dir: Path):
    dlg = Gtk.FileChooserDialog(
        title=title,
        parent=parent,
        action=Gtk.FileChooserAction.OPEN,
    )
    dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
    if initial_dir.exists():
        dlg.set_current_folder(str(initial_dir))

    filt = Gtk.FileFilter()
    filt.set_name("Images")
    for ext in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
        filt.add_pattern(ext)
    dlg.add_filter(filt)

    path = None
    if dlg.run() == Gtk.ResponseType.OK:
        path = dlg.get_filename()
    dlg.destroy()
    return path

def load_pixbuf_scaled(path: Path, max_w=420, max_h=240):
    if not path.exists():
        return None
    pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
    w, h = pb.get_width(), pb.get_height()
    scale = min(max_w / w, max_h / h)
    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))
    return pb.scale_simple(new_w, new_h, GdkPixbuf.InterpType.BILINEAR)

