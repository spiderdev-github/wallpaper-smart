    def on_save(self, _btn):
        # self.on_test(_btn)  # test first to validate inputs
        current_page = self.nb.get_current_page()
        current_widget = self.nb.get_nth_page(current_page)
        try:
            cfg = self.cfg

            def _parse_time_entry(entry, fallback_h=0, fallback_m=0):
                txt = (entry.get_text() or "").strip()
                if not txt:
                    return fallback_h, fallback_m

                if ":" in txt:
                    parts = txt.split(":")
                    if len(parts) != 2:
                        return fallback_h, fallback_m
                    try:
                        h = int(parts[0].strip() or "0")
                        m = int(parts[1].strip() or "0")
                    except Exception:
                        return fallback_h, fallback_m
                else:
                    try:
                        h = int(txt)
                    except Exception:
                        return fallback_h, fallback_m
                    m = 0

                if h < 0:
                    h = 0
                if h > 23:
                    h = 23
                if m < 0:
                    m = 0
                if m > 59:
                    m = 59

                return h, m

            def _format_hm(h, m):
                return f"{int(h):02d}:{int(m):02d}"

            def _get_existing_hm(schedule, key, default_h, default_m):
                v = schedule.get(key, None)

                if isinstance(v, int):
                    return int(v), 0

                if isinstance(v, str):
                    s = v.strip()
                    if ":" in s:
                        parts = s.split(":")
                        if len(parts) == 2:
                            try:
                                return int(parts[0]), int(parts[1])
                            except Exception:
                                return default_h, default_m
                    try:
                        return int(s), 0
                    except Exception:
                        return default_h, default_m

                if isinstance(v, dict):
                    try:
                        h = int(v.get("h", v.get("hour", default_h)))
                        m = int(v.get("m", v.get("minute", default_m)))
                        return h, m
                    except Exception:
                        return default_h, default_m

                return default_h, default_m

            cfg["wallpaper_dir"] = self.folder_entry.get_text().strip()

            # Wallpaper theme
            if hasattr(self, "wall_theme_combo"):
                theme_id = self.wall_theme_combo.get_active_id() or "default"
            else:
                theme_id = cfg.get("wallpaper_theme", "default")

            themes = load_wallpaper_themes(cfg["wallpaper_dir"])
            valid_ids = [k for k, _ in themes]
            if theme_id not in valid_ids:
                theme_id = valid_ids[0]
            cfg["wallpaper_theme"] = theme_id

            cfg["timer_minutes"] = int(self.spin_minutes.get_value())

            # Schedule auto switch
            if hasattr(self, "switch_auto_schedule"):
                cfg["schedule_auto"] = bool(self.switch_auto_schedule.get_active())
            else:
                cfg["schedule_auto"] = bool(cfg.get("schedule_auto", False))

            # --- Schedule (HH:MM) ---
            old_sch = cfg.get("schedule", {}) or {}

            aube_h0, aube_m0 = _get_existing_hm(old_sch, "aube_start", 5, 0)
            midi_h0, midi_m0 = _get_existing_hm(old_sch, "midi_start", 11, 0)
            coucher_h0, coucher_m0 = _get_existing_hm(old_sch, "coucher_start", 16, 0)
            nuit_h0, nuit_m0 = _get_existing_hm(old_sch, "nuit_start", 19, 0)

            aube_h, aube_m = _parse_time_entry(self.entry_aube_time, aube_h0, aube_m0)
            midi_h, midi_m = _parse_time_entry(self.entry_midi_time, midi_h0, midi_m0)
            coucher_h, coucher_m = _parse_time_entry(self.entry_coucher_time, coucher_h0, coucher_m0)
            nuit_h, nuit_m = _parse_time_entry(self.entry_nuit_time, nuit_h0, nuit_m0)

            cfg["schedule"] = {
                "aube_start": _format_hm(aube_h, aube_m),
                "midi_start": _format_hm(midi_h, midi_m),
                "coucher_start": _format_hm(coucher_h, coucher_m),
                "nuit_start": _format_hm(nuit_h, nuit_m),
            }

            cfg["geolocation"]["mode"] = self.geo_combo.get_active_id()
            cfg["geolocation"]["fixed"]["lat"] = float(self.lat_entry.get_text().strip())
            cfg["geolocation"]["fixed"]["lon"] = float(self.lon_entry.get_text().strip())
            cfg["geolocation"]["city_name"] = self.city_entry.get_text().strip()

            preset_id = "none"
            it = None
            try:
                it = self.preset_combo.get_active_iter()
            except Exception:
                it = None

            if it is None:
                preset_id = "none"
            else:
                preset_id = self.preset_store[it][0]

            if not preset_id:
                preset_id = "none"

            if preset_id != "none" and preset_id in GEO_PRESETS and GEO_PRESETS[preset_id][1]:
                lat = float(self.preset_store[it][3])
                lon = float(self.preset_store[it][4])
                label = str(self.preset_store[it][1])
                cfg["geolocation"]["mode"] = "fixed"
                cfg["geolocation"]["fixed"]["lat"] = lat
                cfg["geolocation"]["fixed"]["lon"] = lon
                cfg["geolocation"]["city_name"] = label
                cfg["geolocation"]["preset"] = preset_id

                # Clean city field (remove flag + meteo icon at end if any)
                pretty = label
                for flag in ["🇷🇺","🇺🇸","🇮🇸","🇸🇬","🇦🇪","🇯🇵","🇦🇺","🇲🇦","🇫🇷","🇩🇪","🇪🇸","🇮🇹","🇬🇧","🇨🇦","🇧🇷","🇲🇽","🇿🇦","🇮🇳","🇨🇳"]:
                    pretty = pretty.replace(flag, "")
                pretty = pretty.strip()

                cfg["geolocation"]["city_name"] = pretty
                cfg["geolocation"]["preset"] = preset_id

            save_cfg(self.cfg)

            for k in WEATHER_KEYS_ORDER:
                cfg["weather_mapping"][k] = self.map_entries[k].get_text().strip()

            cfg.setdefault("enabled_images", {})

            migrate_enabled_images(cfg)
            save_cfg(cfg)
            ensure_overrides(cfg)

            root = Path(cfg["wallpaper_dir"])
            theme = (cfg.get("wallpaper_theme") or "default").strip() or "default"
            (root / "templates" / theme / "dark/base").mkdir(parents=True, exist_ok=True)
            (root / "templates" / theme / "dark/meteo").mkdir(parents=True, exist_ok=True)
            (root / "templates" / theme / "light/base").mkdir(parents=True, exist_ok=True)
            (root / "templates" / theme / "light/meteo").mkdir(parents=True, exist_ok=True)

            # rebuild Images tab (mapping dynamic)
            self.wall_theme_combo.set_active_id(theme_id)

            idx_back = self.nb.page_num(current_widget)
            if idx_back != -1:
                self.nb.set_current_page(idx_back)

            self.message("OK", _("ui.saved-successfully"))
            self.refresh_toggle_label()
            self.refresh_dashboard()
            # self.refresh_images_preview()

            # Mettre à jour la météo dans l'AppIndicator
            if HAS_APPINDICATOR and hasattr(self, '_update_indicator_weather'):
                self._update_indicator_weather()
        except Exception as e:
            self.message("Erreur", str(e))


    def on_test(self, _btn):
        try:
            print(" -- on_test --")

            def _parse_time_text(txt: str):
                txt = (txt or "").strip()
                if not txt:
                    return None, None

                if ":" in txt:
                    parts = txt.split(":")
                    if len(parts) != 2:
                        return None, None
                    try:
                        h = int(parts[0].strip() or "0")
                        m = int(parts[1].strip() or "0")
                    except Exception:
                        return None, None
                else:
                    try:
                        h = int(txt)
                    except Exception:
                        return None, None
                    m = 0

                if h < 0:
                    h = 0
                if h > 23:
                    h = 23
                if m < 0:
                    m = 0
                if m > 59:
                    m = 59

                return h, m

            def _format_hm(h, m):
                return f"{int(h):02d}:{int(m):02d}"

            def _get_existing_hm(schedule, key, default_h, default_m):
                v = schedule.get(key, None)

                if isinstance(v, int):
                    return int(v), 0

                if isinstance(v, str):
                    s = v.strip()
                    if ":" in s:
                        parts = s.split(":")
                        if len(parts) == 2:
                            try:
                                return int(parts[0]), int(parts[1])
                            except Exception:
                                return default_h, default_m
                    try:
                        return int(s), 0
                    except Exception:
                        return default_h, default_m

                if isinstance(v, dict):
                    try:
                        h = int(v.get("h", v.get("hour", default_h)))
                        m = int(v.get("m", v.get("minute", default_m)))
                        return h, m
                    except Exception:
                        return default_h, default_m

                return default_h, default_m

            def _read_time_entry(entry, fallback_h, fallback_m):
                txt = (entry.get_text() or "").strip()
                if not txt:
                    return fallback_h, fallback_m
                h, m = _parse_time_text(txt)
                if h is None or m is None:
                    return fallback_h, fallback_m
                return h, m

            # 1) Construire une config temporaire depuis l'UI (sans sauvegarder la vraie)
            cfg = json.loads(json.dumps(self.cfg))  # copie safe

            # Wallpaper dir
            if hasattr(self, "folder_entry"):
                cfg["wallpaper_dir"] = self.folder_entry.get_text().strip()

            # Timer
            if hasattr(self, "spin_minutes"):
                cfg["timer_minutes"] = int(self.spin_minutes.get_value())

            # Schedule (HH:MM)
            old_sch = cfg.get("schedule", {}) or {}
            aube_h0, aube_m0 = _get_existing_hm(old_sch, "aube_start", 5, 0)
            midi_h0, midi_m0 = _get_existing_hm(old_sch, "midi_start", 11, 0)
            coucher_h0, coucher_m0 = _get_existing_hm(old_sch, "coucher_start", 16, 0)
            nuit_h0, nuit_m0 = _get_existing_hm(old_sch, "nuit_start", 19, 0)

            if hasattr(self, "entry_aube_time"):
                aube_h, aube_m = _read_time_entry(self.entry_aube_time, aube_h0, aube_m0)
                midi_h, midi_m = _read_time_entry(self.entry_midi_time, midi_h0, midi_m0)
                coucher_h, coucher_m = _read_time_entry(self.entry_coucher_time, coucher_h0, coucher_m0)
                nuit_h, nuit_m = _read_time_entry(self.entry_nuit_time, nuit_h0, nuit_m0)

                cfg["schedule"] = {
                    "aube_start": _format_hm(aube_h, aube_m),
                    "midi_start": _format_hm(midi_h, midi_m),
                    "coucher_start": _format_hm(coucher_h, coucher_m),
                    "nuit_start": _format_hm(nuit_h, nuit_m),
                }
            # Fallback legacy si jamais tu lances on_test sans avoir l'UI mise a jour
            elif hasattr(self, "spin_nuit"):
                cfg["schedule"] = {
                    "nuit_start": int(self.spin_nuit.get_value()),
                    "aube_start": int(self.spin_aube.get_value()),
                    "midi_start": int(self.spin_midi.get_value()),
                    "coucher_start": int(self.spin_coucher.get_value()),
                }

            # Geoloc (mode + lat/lon + city + preset)
            cfg.setdefault("geolocation", {})
            if hasattr(self, "geo_combo"):
                cfg["geolocation"]["mode"] = self.geo_combo.get_active_id()

            if hasattr(self, "lat_entry") and hasattr(self, "lon_entry"):
                try:
                    cfg["geolocation"].setdefault("fixed", {})
                    cfg["geolocation"]["fixed"]["lat"] = float(self.lat_entry.get_text().strip())
                    cfg["geolocation"]["fixed"]["lon"] = float(self.lon_entry.get_text().strip())
                except Exception:
                    pass

            if hasattr(self, "city_entry"):
                cfg["geolocation"]["city_name"] = self.city_entry.get_text().strip()

            if hasattr(self, "preset_combo"):
                preset_id = self.preset_combo.get_active_id() or "none"
                cfg["geolocation"]["preset"] = preset_id

            # Mapping
            if hasattr(self, "map_entries"):
                cfg.setdefault("weather_mapping", {})
                for k, e in self.map_entries.items():
                    cfg["weather_mapping"][k] = e.get_text().strip()

            # enabled_images
            cfg.setdefault("enabled_images", self.cfg.get("enabled_images", {}))

            # 2) Ecrire config temporaire
            tmp = APP_DIR / "config.test.json"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2, ensure_ascii=False)

            # 3) Lancer wallpaper-smart.sh avec la config temporaire
            script = Path.home() / ".local/bin/wallpaper-smart.sh"
            p = subprocess.run(
                [str(script)],
                text=True,
                capture_output=True,
                env={**os.environ, "CONFIG_FILE": str(tmp)},
            )

            out = (p.stdout + "\n" + p.stderr).strip()
            self.message(_("ui.test-result"), out or _("(ui.test-result-empty)"))
        except Exception as e:
            self.message(_("ui.test-error"), str(e))



    def on_logs(self, _btn):
        try:
            p = run(["journalctl", "--user", "-u", SERVICE, "-n", "10", "--no-pager"])
            self.message(_("ui.logs"), p.stdout.strip() or _("(ui.logs-empty)"))
        except Exception as e:
            self.message(_("ui.logs-error"), str(e))

    def on_toggle_timer(self, _btn):
        try:
            set_timer(not is_timer_active())
            self.refresh_toggle_label()
            self.refresh_dashboard()
        except Exception as e:
            self.message(_("ui.timer-error"), str(e))

def main():
    win = App()
    win.connect("destroy", lambda w: Gtk.main_quit() if not HAS_APPINDICATOR else None)
    
    # Démarrer minimisé dans le tray si AppIndicator est disponible
    if HAS_APPINDICATOR and win.indicator:
        # Ne pas afficher la fenêtre au démarrage
        pass
    else:
        # Si pas d'AppIndicator, afficher normalement
        win.show_all()
    
    Gtk.main()

if __name__ == "__main__":
    main()
