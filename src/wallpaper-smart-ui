    def _compute_current_moment_key(self) -> str:
        """Return current moment according to schedule and current hour."""
        from datetime import datetime
        hour = datetime.now().hour
        sch = self.cfg.get("schedule", {})
        nuit = int(sch.get("nuit_start", 19))
        aube = int(sch.get("aube_start", 5))
        midi = int(sch.get("midi_start", 11))
        coucher = int(sch.get("coucher_start", 17))

        # Simple windows: [aube, midi), [midi, coucher), [coucher, nuit), else nuit
        if aube <= hour < midi:
            return "aube"
        if midi <= hour < coucher:
            return "midi"

        # Handle coucher/nuit even if schedule is unusual
        if coucher < nuit:
            if coucher <= hour < nuit:
                return "coucher"
            return "nuit"
        else:
            # coucher window wraps midnight
            if hour >= coucher or hour < nuit:
                return "coucher"
            return "nuit"

