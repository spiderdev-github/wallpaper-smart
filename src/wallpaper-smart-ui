def geocode_city_async(city: str, callback, timeout: int = 6):
    """
    Geocode city asynchronously using Nominatim.
    Calls callback(lat, lon, display, country_code, error) on GTK main thread.
    """
    def _fetch():
        try:
            result = geocode_city_nominatim(city, timeout=timeout)
            GLib.idle_add(lambda res=result: callback(*res, None))
        except Exception as e:
            error_msg = str(e)
            GLib.idle_add(lambda err=error_msg: callback(None, None, None, None, err))
    
    _http_executor.submit(_fetch)


def auto_ip_details_async(callback):
    """
    Fetch IP-based geolocation asynchronously.
    Calls callback(details: Dict, error: str | None) on GTK main thread.
    """
    def _fetch():
        try:
            result = _auto_ip_details()
            if "_error" in result:
                error_msg = result["_error"]
                GLib.idle_add(lambda err=error_msg: callback({}, err))
            else:
                GLib.idle_add(lambda res=result: callback(res, None))
        except Exception as e:
            error_msg = str(e)
            GLib.idle_add(lambda err=error_msg: callback({}, err))
    
    _http_executor.submit(_fetch)


def geocode_city_nominatim(city: str, timeout: int = 6) -> Tuple[float, float, str, str]:
    import json
    from urllib.parse import quote

    q = quote(city)
    url = f"https://nominatim.openstreetmap.org/search?q={q}&format=json&limit=1&addressdetails=1"

    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "wallpaper-smart/1.0 (UI geocode)",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except Exception as e:
        raise RuntimeError(f"Nominatim error: {e}") from e

    data = json.loads(raw)
    if not isinstance(data, list) or not data:
        raise RuntimeError("Ville introuvable. Essaie: 'Paris, FR'.")

    item = data[0]
    lat = float(item.get("lat"))
    lon = float(item.get("lon"))
    display = (item.get("display_name") or "").strip()

    # Récupérer le code pays depuis address
    address = item.get("address", {})
    country_code = (address.get("country_code") or "").strip().upper()

    # Keep display short
    if display and len(display) > 60:
        display = display.split(",")[0].strip()

    return lat, lon, display, country_code

