def detect_dark_mode() -> bool:
    """
    Detect if the user prefers dark mode.

    GNOME 42+ uses:
      org.gnome.desktop.interface color-scheme = 'prefer-dark' | 'default'
    Fallback to GTK setting if unavailable.
    """

    # GNOME color-scheme (modern)
    try:
        s = Gio.Settings.new("org.gnome.desktop.interface")
        scheme = s.get_string("color-scheme")  # may raise if key doesn't exist
        if scheme == "prefer-dark":
            return True
        if scheme == "default":
            return False
    except Exception:
        pass

    # GTK fallback
    try:
        gtk_settings = Gtk.Settings.get_default()
        return bool(gtk_settings.get_property("gtk-application-prefer-dark-theme"))
    except Exception:
        return False



def _auto_ip_details() -> Dict[str, str | float]:
    """Return best-effort IP-based geolocation details (lat, lon, city, region, country, country_code)."""
    try:
        print("Fetching auto IP geolocation details...", flush=True)

        g = _http_json("https://ipapi.co/json/", timeout=4)

        lat = g.get("latitude")
        lon = g.get("longitude")
        print(f"raw lat={lat} raw lon={lon}", flush=True)

        city = (g.get("city") or "").strip()
        region = (g.get("region") or "").strip()
        country = (g.get("country_name") or g.get("country") or "").strip()
        country_code = (g.get("country_code") or "").strip()

        out: Dict[str, str | float] = {}
        if lat is not None:
            out["lat"] = float(lat)
        if lon is not None:
            out["lon"] = float(lon)
        if city:
            out["city"] = city
        if region:
            out["region"] = region
        if country:
            out["country"] = country
        if country_code:
            out["country_code"] = country_code

        print(f"out={out}", flush=True)
        return out

    except Exception as e:
        msg = str(e)
        print(f"[auto_ip_details] ERROR: {msg}", flush=True)
        return {"_error": msg}


    
def apply_css(dark: bool):
    """
    Load CSS from external files (style-dark.css or style-light.css).
    Falls back to embedded CSS if files don't exist.
    """
    css_filename = "style-dark.css" if dark else "style-light.css"
    css_path = APP_DIR / "css" / css_filename
    
    provider = Gtk.CssProvider()
    
    # Try to load from external file first
    if css_path.exists():
        try:
            provider.load_from_path(str(css_path))
            debug_print(f"CSS chargé depuis: {css_path}")
        except Exception as e:
            debug_print(f"Erreur chargement CSS externe: {e}, fallback sur CSS embarqué")
            # Fallback to embedded CSS
            css = _get_embedded_css(dark)
            provider.load_from_data(css)
    else:
        debug_print(f"Fichier CSS {css_path} introuvable, utilisation du CSS embarqué")
        # Use embedded CSS as fallback
        css = _get_embedded_css(dark)
        provider.load_from_data(css)
    
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


