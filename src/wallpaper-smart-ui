    def on_toggle_image_enabled(self, widget, *args):
        """Instant-save: enable/disable one meteo image.

        Compatible with:
          - Gtk.Switch notify::active -> (switch, pspec, rel_path)
          - Gtk.CheckButton toggled   -> (checkbutton, rel_path)
        """
        try:
            rel_path = None
            if len(args) == 1:
                rel_path = args[0]
            elif len(args) >= 2:
                rel_path = args[1]
            if not rel_path:
                return

            active = bool(widget.get_active()) if hasattr(widget, "get_active") else True

            self.cfg.setdefault("enabled_images", {})
