    def _on_schedule_auto_switch(self, sw, _pspec):
        # Step 2: when ON, fetch sunrise/sunset and set aube/coucher entries
        try:
            enabled = bool(sw.get_active())

            # Optional: disable manual edit for aube/coucher when ON
            try:
                self.entry_aube_time.set_sensitive(not enabled)
                self.entry_coucher_time.set_sensitive(not enabled)
