    def _setup_wallpaper_monitor(self):
        """Surveille le fichier current.json pour mettre à jour l'indicateur quand le fond d'écran change"""
        try:
            wallpaper_dir = self.cfg.get("wallpaper_dir", str(Path.home() / ".config/wallpaper-smart/wallpaper"))
            current_json_path = Path(wallpaper_dir) / "current.json"
            
            if not current_json_path.parent.exists():
                current_json_path.parent.mkdir(parents=True, exist_ok=True)
            
            # Créer le fichier s'il n'existe pas
            if not current_json_path.exists():
                current_json_path.write_text("{}")
            
            # Créer un FileMonitor pour surveiller les modifications
            gfile = Gio.File.new_for_path(str(current_json_path))
            monitor = gfile.monitor_file(Gio.FileMonitorFlags.NONE, None)
            
            # Stocker le timestamp de la dernière mise à jour
            self._last_wallpaper_update = 0
            
            def on_file_changed(monitor, file, other_file, event_type):
                """Callback appelé quand current.json change"""
                try:
                    if event_type == Gio.FileMonitorEvent.CHANGED or event_type == Gio.FileMonitorEvent.CREATED:
                        # Vérifier le timestamp pour éviter les mises à jour en boucle
                        try:
                            stat = current_json_path.stat()
                            if stat.st_mtime != self._last_wallpaper_update:
                                self._last_wallpaper_update = stat.st_mtime
                                debug_print("current.json modifié, mise à jour de l'indicateur")
                                # Mettre à jour l'indicateur avec un léger délai
                                GLib.timeout_add(500, lambda: (self._update_indicator_weather(), False)[1])
                                # Mettre à jour le dashboard si la fenêtre est visible
                                if self.get_visible() and hasattr(self, 'refresh_dashboard'):
                                    GLib.timeout_add(600, lambda: (self.refresh_dashboard(), False)[1])
                        except Exception:
                            pass
                except Exception as e:
                    debug_print(f"Erreur dans on_file_changed: {e}")
            
            monitor.connect("changed", on_file_changed)
            
            # Garder une référence au monitor pour éviter qu'il soit garbage collected
            self._wallpaper_monitor = monitor
            
            debug_print(f"Surveillance activée sur: {current_json_path}")
            
        except Exception as e:
            debug_print(f"Erreur lors de la configuration de la surveillance du fond d'écran: {e}")
    
