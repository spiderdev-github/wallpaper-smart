    def apply_meteo_filter(self, moment_key: str):
        self._set_meteo_title(moment_key)

        if not getattr(self, "meteo_rows", None):
            return

        any_visible = False

        for rel, row in self.meteo_rows.items():
            mk = self.meteo_row_moment.get(rel)

            # Fallback: try to detect moment directly from rel
            if mk is None:
                if f"_{moment_key}.png" in rel:
                    mk = moment_key

            visible = (mk == moment_key)

            row.set_visible(visible)
            if visible:
                any_visible = True

        if not any_visible:
            self.meteo_title_label.set_text(
                _("Météo — aucun fond disponible pour ce moment")
            )




    def _build_meteo_items_from_mapping(self) -> List[Tuple[str, str]]:
        mapping = {}
        if hasattr(self, "map_entries") and self.map_entries:
            for k in WEATHER_KEYS_ORDER:
                mapping[k] = self.map_entries[k].get_text().strip()
        else:
            mapping = self.cfg.get("weather_mapping", {})

        items: List[Tuple[str, str]] = []
        for key in WEATHER_KEYS_ORDER:
            prefix = (mapping.get(key) or "").strip()
            if not prefix:
                continue
            for moment_key, _moment_label in MOMENTS:
                label = f"{prefix}_{moment_key}"
                rel = self._rel_path(f"{self.style_list.get_active_id()}/meteo", f"{prefix}_{moment_key}.png")
                items.append((label, rel))
        return items

