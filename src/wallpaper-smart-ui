    def _select_base_moment(self, moment_key: str):
        """Select a base moment in the left list + apply filter on the right."""
        if not getattr(self, "base_rows", None):
            return
        if moment_key not in self.base_rows:
            return
        row = self.base_rows[moment_key][0]
        if getattr(self, "base_list", None):
            self.base_list.select_row(row)
        self.images_selected_moment = moment_key
        self.apply_meteo_filter(moment_key)
    
    
            
