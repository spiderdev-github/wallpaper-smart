def disable_scroll_change(widget):
    """
    Disable mouse wheel changing values on ComboBox/ComboBoxText.
    Prevents accidental changes when user scrolls the window.
    """
    widget.connect("scroll-event", lambda _w, _e: True)

def set_hand_cursor_on_hover(widget):
    widget.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)

    def on_enter(w, _e):
        win = w.get_window()
        if win:
            win.set_cursor(Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "pointer"))
        return False

    def on_leave(w, _e):
        win = w.get_window()
        if win:
            win.set_cursor(None)
        return False

    widget.connect("enter-notify-event", on_enter)
    widget.connect("leave-notify-event", on_leave)




def _detect_system_lang() -> str:
    # Try LANG=fr_FR.UTF-8 -> fr_FR
    try:
        lang = os.environ.get("LANG", "") or ""
        if "." in lang:
            lang = lang.split(".", 1)[0]
        if lang:
            return lang
    except Exception:
        pass

    # Fallback locale module
    try:
        loc = locale.getdefaultlocale()[0]
        if loc:
            return loc
    except Exception:
        pass

    return APP_LANG_DEFAULT


def _load_lang_file(lang_dir: Path, code: str) -> dict:
    p = lang_dir / f"{code}.json"
    try:
        if p.exists():
            return json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        pass
    return {}


def init_i18n_json(cfg: dict, lang_dir: Path | None = None) -> None:
    global _tr, _tr_fallback

    custom = APP_DIR / "lang"
    if custom.exists():
        lang_dir = custom

    ui = cfg.get("ui", {}) if isinstance(cfg.get("ui", {}), dict) else {}
    lang = str(ui.get("language", "system") or "system").strip()

    if not lang_dir:
        # lang folder next to this script
        here = Path(__file__).resolve().parent
        lang_dir = here / "lang"

    if lang == "system" or not lang:
        lang = _detect_system_lang()

    # Load fallback first
    _tr_fallback = _load_lang_file(lang_dir, APP_LANG_DEFAULT)

    # Load selected lang
    _tr = _load_lang_file(lang_dir, lang)

    # If selected file not found, keep fallback
    if not _tr:
        _tr = dict(_tr_fallback)


def _(key: str) -> str:
    try:
        if key in _tr:
            return str(_tr[key])
        if key in _tr_fallback:
            return str(_tr_fallback[key])
        return key
    except Exception:
        return key

def fetch_weather_code(lat: float, lon: float, timeout: int = 3) -> int:
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}&current=weather_code"
    )
    d = _http_json(url, timeout=timeout)
    cur = d.get("current") or {}
    return int(cur.get("weather_code") or 0)


# ---------------- Wallpaper themes ----------------
def load_wallpaper_themes(wallpaper_dir: str) -> List[Tuple[str, str]]:
    root = Path(wallpaper_dir).expanduser()
    troot = root / "templates"
    out: List[Tuple[str, str]] = []

    if not troot.exists():
        return [("default", "Defaut")]

    required = ["aube.png", "midi.png", "coucher.png", "nuit.png"]

    for d in sorted([p for p in troot.iterdir() if p.is_dir()]):
        theme_id = d.name

        base_dir = d / "base"
        if not base_dir.is_dir():
            continue

        ok = True
        for fn in required:
            if not (base_dir / fn).is_file():
                ok = False
                break
        if not ok:
            continue

        label = theme_id

        meta = d / "theme.json"
        if meta.is_file():
            try:
                data = json.loads(meta.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    name = str(data.get("name") or "").strip()
                    if name:
                        label = name
            except Exception:
                pass

        out.append((theme_id, label))

    if not out:
        return [("default", "Defaut")]

    return out


def _http_json(url: str, timeout: int = 5) -> Dict[str, Any]:
    """
    Fetch JSON from URL with a hard timeout.
    Raises exceptions on HTTP/network/JSON errors.
    """
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "wallpaper-smart/1.0",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", errors="replace") if hasattr(e, "read") else ""
        raise RuntimeError(f"HTTPError {e.code} on {url}: {body[:200]}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"URLError on {url}: {e.reason}") from e
    except socket.timeout as e:
        raise RuntimeError(f"Timeout after {timeout}s on {url}") from e

    obj = json.loads(raw)
    if not isinstance(obj, dict):
        raise RuntimeError(f"Expected JSON object, got {type(obj).__name__}")
    return obj


def geocode_city_nominatim(city: str, timeout: int = 6) -> Tuple[float, float, str]:
    import json
    from urllib.parse import quote

    q = quote(city)
    url = f"https://nominatim.openstreetmap.org/search?q={q}&format=json&limit=1&addressdetails=0"

    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "wallpaper-smart/1.0 (UI geocode)",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
    except Exception as e:
        raise RuntimeError(f"Nominatim error: {e}") from e

    data = json.loads(raw)
    if not isinstance(data, list) or not data:
        raise RuntimeError("Ville introuvable. Essaie: 'Paris, FR'.")

    item = data[0]
    lat = float(item.get("lat"))
    lon = float(item.get("lon"))
    display = (item.get("display_name") or "").strip()

    # Keep display short
    if display and len(display) > 60:
        display = display.split(",")[0].strip()

    return lat, lon, display

